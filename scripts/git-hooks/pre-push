# Blocks push if npm test fails. Does NOT replace Two-Key merge:gate.
# Emergency skip (Commander / Seat A only): MARCIALE_HOOK_SKIP=1 git push
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if [ "${MARCIALE_HOOK_SKIP:-}" = "1" ]; then
